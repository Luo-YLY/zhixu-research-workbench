# Configure these in your process environment; Spring Boot does not load this file automatically.
SPRING_PROFILES_ACTIVE=postgres
SERVER_PORT=18081
DB_URL=jdbc:postgresql://127.0.0.1:55432/research_workbench
DB_USERNAME=research_app
DB_PASSWORD=replace-with-your-own-password
WORKBENCH_DATA_DIR=./data

# Optional: full path to the installed native Codex CLI executable.
# Leave unset for detection in the desktop installation or PATH. Authenticate in Codex itself.
# CODEX_EXECUTABLE=path/to/installed/codex.exe

# Default: no detection and no model calls. To opt in later, use codex or model-api.
ASSISTANT_PROVIDER=disabled
# Compatible Chat Completions base URL, including provider-specific prefix (e.g. /v1).
# Do not include /chat/completions; the adapter appends it. Do not put keys in the URL.
# MODEL_API_BASE_URL=http://127.0.0.1:1234/v1
# MODEL_API_MODEL=your-model-name
# MODEL_API_KEY=configure-in-process-environment-only
